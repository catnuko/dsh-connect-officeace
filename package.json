{
  "name": "dsh-connect-officeace",
  "displayName": "DSH Connect OfficeAce",
  "description": "把本机 OfficeAce（华为 MaaS 网关）已登录的模型接入 DeepSeek Harness：复用其内置模型凭据，无需重新配置 API Key。",
  "version": "0.2.1",
  "author": "local",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "officeace",
    "huawei-maas",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.4 <4.0.0"
  }
}
